{
  "name": "compound-wahala",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node --experimental-strip-types scripts/seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/logic.test.ts tests/story.test.ts",
    "e2e": "node tests/e2e.mjs && node tests/story.mjs",
    "e2e:story": "node tests/story.mjs",
    "shots": "node tests/shots.mjs",
    "growth:server": "node growth/server.mjs",
    "growth:capture": "node growth/marketing/capture.mjs --all",
    "growth:generate": "node growth/marketing/generate.mjs",
    "growth:publish": "node growth/marketing/publish.mjs",
    "growth:report": "node growth/marketing/report.mjs",
    "growth:test": "node --test growth/tests/analytics.test.mjs growth/tests/workflow.test.mjs growth/tests/report.test.mjs growth/tests/payments.test.mjs",
    "growth:store-e2e": "node growth/tests/store-e2e.mjs",
    "growth:integration": "node growth/tests/integration.mjs",
    "growth:live-check": "node tests/live-analytics.mjs",
    "seo:shots": "node scripts/seo-shots.mjs",
    "seo:check": "node --experimental-strip-types scripts/seo.mjs --check",
    "seo:ping": "node scripts/seo-ping.mjs",
    "test:seo": "node --experimental-strip-types --test tests/seo.test.mjs",
    "portal:crazygames": "node scripts/portal-build.mjs crazygames",
    "portal:test": "node tests/portal.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "description": "COMPOUND WAHALA: Naija Neighbourhood Wars — a browser comedy/social-sim about life in a shared Nigerian compound."
}
