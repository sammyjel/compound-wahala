# Copy to growth/.env (git-ignored) and fill in only what you use. Never commit real values.
# Every integration is OFF until its values are present AND growth/config.json allows it.

# ── Local growth server / dashboard ──
ADMIN_TOKEN=                 # long random string (32+ chars). Same value as the Worker secret.
GROWTH_PORT=8787
# ANALYTICS_URL=https://compound-wahala-analytics.<you>.workers.dev   # deployed Worker (for report.mjs)

# ── Game build ──
# VITE_ANALYTICS_URL is read at build time:  VITE_ANALYTICS_URL=https://... npm run build

# ── Notifications (optional, free): private topic on https://ntfy.sh — install the ntfy app and subscribe ──
NOTIFY_WEBHOOK=              # e.g. https://ntfy.sh/compound-wahala-<random-words>

# ── AI copywriting (optional, paid per use; capped by config.json spend.aiMonthlyLimitUSD) ──
ANTHROPIC_API_KEY=

# ── YouTube Shorts publishing + stats (official YouTube Data API v3, OAuth) ──
# Google Cloud project → enable "YouTube Data API v3" and "YouTube Analytics API" → OAuth client (Desktop)
# then run: node growth/marketing/youtube-auth.mjs  to obtain the refresh token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Not implemented as API adapters yet (manual publishing tasks are created instead) ──
# TikTok Content Posting API needs an approved TikTok developer app (audit) for public posts.
# Instagram/Facebook Reels need a Meta app with instagram_content_publish / pages_manage_posts (App Review).
